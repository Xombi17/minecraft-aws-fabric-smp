# Example local configuration for mc-server CLI (~/.config/mc-server/config.env)
AWS_REGION="${AWS_REGION:-ap-south-1}"
AWS_PROFILE="${AWS_PROFILE:-default}"
INSTANCE_ID="${INSTANCE_ID:-i-xxxxxxxxxxxxxxxxx}"
SSH_KEY="${SSH_KEY:-$HOME/Documents/minecraft-key.pem}"
SSH_USER="${SSH_USER:-ec2-user}"
MC_PORT="${MC_PORT:-25565}"
MC_DIR="${MC_DIR:-/home/ec2-user/minecraft}"
POLL_INTERVAL="${POLL_INTERVAL:-5}"
SSH_WAIT_TIMEOUT="${SSH_WAIT_TIMEOUT:-120}"
MC_WAIT_TIMEOUT="${MC_WAIT_TIMEOUT:-120}"
EC2_WAIT_TIMEOUT="${EC2_WAIT_TIMEOUT:-180}"
