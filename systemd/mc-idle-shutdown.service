[Unit]
Description=Minecraft Idle Auto-Shutdown Monitor
After=minecraft.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
EnvironmentFile=-/etc/default/mc-idle-shutdown
ExecStart=/usr/bin/python3 /home/ec2-user/minecraft/scripts/mc-idle-monitor.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mc-idle-shutdown

[Install]
WantedBy=multi-user.target
