# ==============================================================================
# Reusable AWS Minecraft Fabric SMP Deployment Configuration
# Copy to `my-server.env`, edit your AWS/Minecraft settings, and run:
#   ./template/deploy.sh --config my-server.env [--dry-run]
# ==============================================================================

# --- AWS Target ---
AWS_PROFILE="default"
AWS_REGION="ap-south-1"
PROJECT_NAME="minecraft-smp"

# --- EC2 Compute & Storage ---
# Free-Plan max RAM: m7i-flex.large (2 vCPU, 8 GiB, x86_64)
# Paid-Plan 16 GiB options in Mumbai: m6a.xlarge (best value), m8i.xlarge, m8a.xlarge, m8g.xlarge (arm64)
INSTANCE_TYPE="m7i-flex.large"
INSTANCE_ARCH="x86_64"              # x86_64 or arm64
EBS_VOLUME_SIZE="30"                # GB (gp3)
EBS_DELETE_ON_TERMINATION="false"   # Protect world volume against accidental termination

# --- Networking & Security ---
ALLOCATE_ELASTIC_IP="true"          # true = static IP (~$3.65/mo 24/7); false = ephemeral IP on start
SSH_ALLOWED_CIDR="auto"             # "auto" uses your current public IP/32, or specify e.g. "1.2.3.4/32"

# --- Scoped Friend Access & Budget Alert ---
CREATE_FRIEND_IAM="true"            # Creates scoped Policy + Role + User for friend start/stop CLI
FRIEND_IAM_PREFIX=""                # Optional prefix (defaults to PROJECT_NAME)
CREATE_BUDGET_ALERT="true"
BUDGET_AMOUNT_USD="25"
BUDGET_EMAIL=""                     # Required if CREATE_BUDGET_ALERT=true (e.g. you@example.com)

# --- Minecraft & Loader ---
MC_VERSION="26.3"                   # Exact MC version (e.g. "26.3", "26.4") or "latest"
FABRIC_LOADER_VERSION="latest"      # "latest" = latest stable Fabric Loader from meta.fabricmc.net
JAVA_VERSION="auto"                 # "auto" reads Mojang manifest javaVersion.majorVersion -> Amazon Corretto RPM

# --- JVM Optimization ---
HEAP_MB="auto"                      # "auto" (~65% RAM on <=8GiB, ~10240M on 16GiB) or explicit integer MB e.g. 5120
GC_MODE="zgc"                       # "zgc" (Java 21+/25 Generational ZGC) or "g1gc"

# --- Gameplay & server.properties ---
MC_MOTD="Minecraft Fabric SMP"
MC_DIFFICULTY="easy"                # peaceful | easy | normal | hard
MC_GAMEMODE="survival"              # survival | creative | adventure
MC_MAX_PLAYERS="20"
MC_VIEW_DISTANCE="8"
MC_SIM_DISTANCE="6"
MC_WHITELIST="false"                # true or false
MC_SEED=""                          # Blank for random fresh seed
MC_SPAWN_PROTECTION="0"
MC_PAUSE_EMPTY_SECONDS="60"

# --- Mods & Datapacks ---
MOD_LIST_FILE="template/modpacks/server-optimization.txt"
VANILLATWEAKS_CONFIG="template/datapacks/vanillatweaks-default.json"

# --- Lifecycle, Idle Auto-Shutdown & Backups ---
IDLE_TIMEOUT_SECONDS="1200"         # 20 minutes at 0 players before save + stop + poweroff
IDLE_CHECK_INTERVAL="30"
IDLE_BOOT_GRACE="300"
BACKUP_RETENTION_SCHEDULED="7"

# --- Local Paths ---
SSH_KEY_NAME=""                     # Blank = "${PROJECT_NAME}-key"
LOCAL_KEY_DIR="$HOME/Documents"
LOCAL_CLI_PATH="$HOME/Documents/mc-server.sh"
LOCAL_CLI_CONFIG="$HOME/.config/mc-server/config.env"
